{
  "name": "dreamcircuit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DREAM CIRCUIT: a retro kart racer whose circuits are dreamed live by a diffusion model, plus a neural world model you can drive, on WebGPU.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "parity-report": "WRITE_PARITY=1 vitest run tests/sim.parity.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
